# Supabase Project API Credentials
# Get these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google OAuth Credentials
# Paste these into Supabase Dashboard -> Authentication -> Providers -> Google
# CLOUD_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# CLOUD_SECRET=your-google-client-secret
